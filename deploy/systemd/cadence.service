[Unit]
Description=Cadence - Personal Life & Repertoire Studio (ASP.NET Core Single-Port Host)
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/.local/opt/cadence/deploy/current
ExecStart=%h/.local/opt/cadence/deploy/current/Cadence.Api
Restart=on-failure
RestartSec=5s

Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=ASPNETCORE_URLS=http://127.0.0.1:5006
EnvironmentFile=-%h/.config/cadence/cadence.env

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
