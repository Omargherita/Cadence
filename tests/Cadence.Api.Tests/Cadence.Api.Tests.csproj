<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RunSettingsFilePath>$(MSBuildThisFileDirectory)../../.runsettings</RunSettingsFilePath>
    <UserDotNetRoot Condition="Exists('$(HOME)/.dotnet/dotnet') and !Exists('/usr/share/dotnet/shared/Microsoft.AspNetCore.App')">$(HOME)/.dotnet</UserDotNetRoot>
  </PropertyGroup>

  <Target Name="ConfigurePortableDotNetTestHost" BeforeTargets="VSTest" Condition="'$(UserDotNetRoot)' != ''">
    <PropertyGroup>
      <_GeneratedRunSettings>$(IntermediateOutputPath)portable.runsettings</_GeneratedRunSettings>
      <_GeneratedRunSettingsContent><![CDATA[<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <RunConfiguration>
    <DotNetHostPath>$(UserDotNetRoot)/dotnet</DotNetHostPath>
    <EnvironmentVariables>
      <DOTNET_ROOT>$(UserDotNetRoot)</DOTNET_ROOT>
    </EnvironmentVariables>
  </RunConfiguration>
</RunSettings>]]></_GeneratedRunSettingsContent>
      <VSTestSetting>$(_GeneratedRunSettings)</VSTestSetting>
    </PropertyGroup>
    <WriteLinesToFile File="$(_GeneratedRunSettings)" Lines="$(_GeneratedRunSettingsContent)" Overwrite="true" />
  </Target>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Cadence.Api\Cadence.Api.csproj" />
  </ItemGroup>

</Project>