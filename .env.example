# Cadence Environment Configuration
# Copy to ~/.config/cadence/cadence.env (mode 0600) for systemd user service deployment.

# --- Network Binding & Same-Origin Guard ---
# Loopback by default (recommended when serving over HTTPS with `tailscale serve --bg 5006`).
# Set to http://0.0.0.0:5006 ONLY if you explicitly opt into direct unauthenticated LAN access.
ASPNETCORE_URLS=http://127.0.0.1:5006
ASPNETCORE_ENVIRONMENT=Production
# Guard mutating /api/* routes (POST/PUT/PATCH/DELETE and uploads) against cross-origin browser requests.
# Set to false if you get locked out after changing how Cadence is exposed.
# Cadence__EnableOriginCheck=true
# Comma- or semicolon-separated list of additional allowed Origin headers or hostnames
# (e.g. https://arch-host.tailnet.ts.net when proxied via Tailscale Serve):
# Cadence__AllowedOrigins=

# --- AI Piano Mentor (Google Gemini API) ---
# Leave blank to run in local diagnostic mode without external API calls.
GEMINI_API_KEY=
# Cadence__GeminiModel=gemini-2.5-flash

# --- Storage & Backups ---
# Defaults to ~/.local/share/cadence when unset.
# CADENCE_STORAGE_ROOT=/home/your-user/.local/share/cadence
# CADENCE_BACKUP_RETENTION_COUNT=30

# --- Audio DSP Worker Paths ---
# Defaults to the bundled tools/audio_analyzer/analyze.py and colocated .venv/bin/python.
# CADENCE_DSP_PYTHON=/home/your-user/.local/share/cadence/python-dsp/.venv/bin/python
# CADENCE_DSP_SCRIPT=/home/your-user/.local/opt/cadence/deploy/current/tools/audio_analyzer/analyze.py

# --- Local Calendar TimeZone ---
# Cadence__TimeZone=Asia/Riyadh
